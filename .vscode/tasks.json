{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build Envimix Website",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/EnvimixWebsite/EnvimixWebsite/EnvimixWebsite.csproj",
                "--no-restore"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "build Envimix Web API",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/EnvimixWebAPI/EnvimixWebAPI.csproj",
                "--no-restore"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
