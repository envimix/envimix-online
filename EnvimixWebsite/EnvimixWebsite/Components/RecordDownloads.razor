@inject IEnvimixService EnvimixService

@if (GhostId is not null || ReplayId is not null || ValidationReplayId is not null)
{
    <div class="download-actions">
        @if (ReplayId is Guid replayId)
        {
            <ReuButton Enable="false" Href="@EnvimixService.GetReplayViewUrl(replayId)">View</ReuButton>
            <ReuButton Href="@EnvimixService.GetReplayDownloadUrl(replayId)" download><img src="img/icons/replay.svg" alt="Download replay" width="24" height="24" /></ReuButton>
        }
        @if (ValidationReplayId is Guid validationReplayId)
        {
            <ReuButton Href="@EnvimixService.GetReplayDownloadUrl(validationReplayId)" download><img src="img/icons/validation_replay.svg" alt="Download validation replay" width="24" height="24" /></ReuButton>
        }
        @if (GhostId is Guid ghostId)
        {
            <ReuButton Href="@EnvimixService.GetGhostDownloadUrl(ghostId)" download><img src="img/icons/ghost.svg" alt="Download ghost" width="24" height="24" /></ReuButton>
        }
    </div>
}

@code {
    [Parameter]
    public Guid? GhostId { get; set; }

    [Parameter]
    public Guid? ReplayId { get; set; }

    [Parameter]
    public Guid? ValidationReplayId { get; set; }
}
