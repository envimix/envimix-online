@if (IsRegistered)
{
    <ReuButton Enable="false">Registered</ReuButton>
}
else
{
    <form method="post" action="/profile/servers/register">
        <AntiforgeryToken />
        <input type="hidden" name="serverLogin" value="@ServerLogin" />
        <ReuButton type="submit">Register</ReuButton>
    </form>
}

@code {
    [Parameter, EditorRequired]
    public required string ServerLogin { get; set; }

    [Parameter]
    public bool IsRegistered { get; set; }
}
