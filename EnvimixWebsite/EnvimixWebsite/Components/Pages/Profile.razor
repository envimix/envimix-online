@page "/profile"
@using System.Security.Claims
@using EnvimixWebsite.Services
@inject IIdentityService IdentityService
@inject IEnvimixService EnvimixService
@inject NavigationManager NavManager
@inject ILogger<Profile> Logger
@attribute [Authorize]
@attribute [StreamRendering]

<PageTitle>Profile - ENVIMIX project</PageTitle>

<ReuContainer>
    <h2>Profile</h2>

    <AuthorizeView>
        <Authorized>
            <p>Welcome, @(context.User.Identity?.Name ?? context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value)!</p>

            @if (userInfo is not null)
            {
                var servers = userInfo.Data?.ManiaPlanet?.DedicatedAccounts ?? [];

                @if (userInfo.Providers.TryGetValue("ManiaPlanet", out var mpUser))
                {
                    var dedicatedServers = servers
                        .Where(x => !string.Equals(x.Login, mpUser.Id, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    <ul>
                        <li>Your ManiaPlanet login: @mpUser.Id</li>
                        <li>Your ManiaPlanet nickname: <TmEssentials.Razor.FormattedText Text="@mpUser.Name"></TmEssentials.Razor.FormattedText></li>
                    </ul>
                    <h3>Register your login as a server to Envimania</h3>
                    <p>Registering your ManiaPlanet login as a server allows Envimania support for online server created by your ManiaPlanet client.</p>
                    <ServerRegistrationButton ServerLogin="@mpUser.Id" IsRegistered="@registeredServers.Contains(mpUser.Id)" />

                    <h3>Register dedicated server to Envimania</h3>
                    @if (dedicatedServers.Count == 0)
                    {
                        <p>You don't have any dedicated server accounts associated with your ManiaPlanet account.</p>
                        <p>Visit <a href="https://maniaplanet.com/account/dedicated-servers">ManiaPlanet Dedicated Server accounts</a> to create one.</p>
                    }
                    else
                    {
                        <table class="server-table">
                            <thead>
                                <tr>
                                    <th scope="col">Server login</th>
                                    <th scope="col">Last seen online</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var server in dedicatedServers)
                            {
                                <tr>
                                    <td>@server.Login</td>
                                    <td>@(server.LastUsedAt is null ? "Never" : DateTimeOffset.FromUnixTimeSeconds(server.LastUsedAt.Value).ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))</td>
                                    <td class="server-action">
                                        <ServerRegistrationButton ServerLogin="@server.Login" IsRegistered="@registeredServers.Contains(server.Login)" />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <p>Don't see your server? Try <a href="login/maniaplanet?returnUrl=@(Uri.EscapeDataString(NavManager.Uri))">reconnecting the ManiaPlanet account</a>.</p>
                    }
                }
                else
                {
                    <p>You don't have a ManiaPlanet account associated with your account. Here is <a href="login/maniaplanet?returnUrl=@(Uri.EscapeDataString(NavManager.Uri))">a quick link to associate it</a>.</p>
                }
            }
            else if (isLoading)
            {
                <p>Loading more information...</p>
            }
            else
            {
                <p>Unable to load detailed user information at this time.</p>                
            }
        </Authorized>
    </AuthorizeView>
</ReuContainer>

@code {
    private UserDto? userInfo;
    private bool isLoading = true;
    private HashSet<string> registeredServers = new(StringComparer.OrdinalIgnoreCase);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    userInfo = await IdentityService.GetCurrentUserAsync(authState.User);
                    var serverLogins = userInfo?.Data?.ManiaPlanet?.DedicatedAccounts.Select(x => x.Login).ToList() ?? [];
                    if (userInfo?.Providers.TryGetValue("ManiaPlanet", out var maniaPlanetUser) == true)
                    {
                        serverLogins.Add(maniaPlanetUser.Id);
                    }
                    registeredServers = await EnvimixService.GetRegisteredServersAsync(serverLogins);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Unable to load profile information");
                }
            }
        }
        
        isLoading = false;
    }
}
