@page "/users/{UserLogin}"
@using TmEssentials
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<UserDetails> Logger
@attribute [StreamRendering]

<PageTitle>@TextFormatter.Deformat(user is null ? UserLogin : GetUserName(user)) - ENVIMIX player</PageTitle>
<HeadContent>
    <MetadataTags Title="@(TextFormatter.Deformat(user is null ? UserLogin : GetUserName(user)) + " - ENVIMIX player")"
                  Description="@GetMetadataDescription()"></MetadataTags>
</HeadContent>

<ReuContainer>
    @if (isLoading)
    {
        <p>Loading player...</p>
    }
    else if (loadFailed)
    {
        <h2>@UserLogin</h2>
        <p>Unable to load this player at this time.</p>
    }
    else if (user is null)
    {
        <h2>Player not found</h2>
        <p>This player does not exist or is not available.</p>
    }
    else
    {
        <h2><FormattedText Text="@GetUserName(user)"></FormattedText></h2>
        @if (!string.Equals(user.Login, user.Nickname, StringComparison.Ordinal))
        {
            <p class="user-login">@user.Login</p>
        }

        <dl class="detail-summary">
            <div>
                <dt>Zone</dt>
                <dd>@(string.IsNullOrWhiteSpace(user.Zone) ? "Unknown" : user.Zone)</dd>
            </div>
            <div>
                <dt>Records</dt>
                <dd>@user.RecordCount</dd>
            </div>
        </dl>

        <h3>Recent records</h3>
        @if (user.RecentRecords.Length == 0)
        {
            <p>This player has no records.</p>
        }
        else
        {
            var showLaps = user.RecentRecords.Any(record => ShouldShowLaps(record.MapLaps));
            <div class="records-scroll">
                <table class="records-table">
                    <thead>
                        <tr>
                            <th scope="col">Map</th>
                            <th scope="col">Car</th>
                            @if (showLaps)
                            {
                                <th scope="col">Laps</th>
                            }
                            <th scope="col">Time</th>
                            <th scope="col">Driven</th>
                            <th scope="col">Server</th>
                            @if (canAdminister)
                            {
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in user.RecentRecords)
                        {
                            <tr class="@(record.Removed ? "removed-record" : null)">
                                <td>
                                    <a class="primary-value" href="@GetMapUrl(record.MapUid)"><FormattedText Text="@GetMapName(record)"></FormattedText></a>
                                    @if (!string.IsNullOrWhiteSpace(record.MapName))
                                    {
                                        <small>@record.MapUid</small>
                                    }
                                </td>
                                <td><CarDisplay CarId="@record.Car" /></td>
                                @if (showLaps)
                                {
                                    <td>@FormatRecordLaps(record.MapLaps, record.Laps)</td>
                                }
                                <td>
                                    <a href="@GetRecordUrl(record)">@FormatTime(record.Time)</a>
                                    @if (record.Removed)
                                    {
                                        <span class="removed-note">(removed)</span>
                                    }
                                </td>
                                <td><LocalDateTime Value="@record.DrivenAt" /></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(record.ServerLogin))
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <a href="@GetServerOrSessionUrl(record)">
                                            @if (string.IsNullOrWhiteSpace(record.ServerName))
                                            {
                                                @record.ServerLogin
                                            }
                                            else
                                            {
                                                <FormattedText Text="@record.ServerName"></FormattedText>
                                            }
                                        </a>
                                    }
                                </td>
                                @if (canAdminister)
                                {
                                    <td>
                                        <form method="post" action="@(record.Removed ? "/records/revert" : "/records/remove")" onsubmit="return confirm('@(record.Removed ? "Restore this record?" : "Remove this record?")');">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="redirectToUser" value="true" />
                                            <input type="hidden" name="mapUid" value="@record.MapUid" />
                                            <input type="hidden" name="login" value="@record.UserLogin" />
                                            <input type="hidden" name="carId" value="@record.Car" />
                                            <input type="hidden" name="gravity" value="@record.Gravity" />
                                            <input type="hidden" name="laps" value="@record.Laps" />
                                            <input type="hidden" name="time" value="@record.Time" />
                                            <ReuButton type="submit">@(record.Removed ? "Restore" : "Remove")</ReuButton>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string UserLogin { get; set; } = "";

    private PlayerInfo? user;
    private bool isLoading = true;
    private bool loadFailed;
    private bool canAdminister;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string GetMetadataDescription()
        => user is null
            ? $"View records driven by {UserLogin} in ENVIMIX."
            : $"Browse {user.RecordCount} records driven by {TextFormatter.Deformat(GetUserName(user))}.";

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            canAdminister = authState.User.IsInRole(Roles.Admin);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            user = await EnvimixService.GetUserAsync(UserLogin);
        }
        catch (Exception ex)
        {
            user = null;
            loadFailed = true;
            Logger.LogError(ex, "Unable to load player {UserLogin}", UserLogin);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetUserName(PlayerInfo value)
        => string.IsNullOrWhiteSpace(value.Nickname) ? value.Login : value.Nickname;

    private static string GetMapName(RecordInfo record)
        => string.IsNullOrWhiteSpace(record.MapName) ? record.MapUid : record.MapName;

    private static string GetMapUrl(string mapUid)
        => $"/maps/{Uri.EscapeDataString(mapUid)}";

    private static string GetRecordUrl(RecordInfo record)
        => $"/records/{Uri.EscapeDataString(record.MapUid)}/{Uri.EscapeDataString(record.Car)}/{Uri.EscapeDataString(record.UserLogin)}/{record.Time}";

    private static string GetServerOrSessionUrl(RecordInfo record)
        => record.SessionId is Guid sessionId
            ? $"/envimania/sessions/{sessionId}"
            : $"/envimania/servers/{Uri.EscapeDataString(record.ServerLogin!)}";

    private static string FormatTime(int milliseconds)
        => TimeSpan.FromMilliseconds(milliseconds).ToString(milliseconds >= 3_600_000 ? @"h\:mm\:ss\.fff" : @"m\:ss\.fff");

    private static bool ShouldShowLaps(int mapLaps)
        => mapLaps == 0 || mapLaps > 1;

    private static string FormatRecordLaps(int mapLaps, int recordLaps)
        => mapLaps == 0 ? "Independent laps" : mapLaps > 1 ? recordLaps.ToString() : "";
}
