@page "/users/{UserLogin}"
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<UserDetails> Logger
@attribute [StreamRendering]

<PageTitle>@(user is null ? UserLogin : GetUserName(user)) - ENVIMIX player</PageTitle>

<ReuContainer>
    @if (isLoading)
    {
        <p>Loading player...</p>
    }
    else if (loadFailed)
    {
        <h2>@UserLogin</h2>
        <p>Unable to load this player at this time.</p>
    }
    else if (user is null)
    {
        <h2>Player not found</h2>
        <p>This player does not exist or is not available.</p>
    }
    else
    {
        <h2><FormattedText Text="@GetUserName(user)">@GetUserName(user)</FormattedText></h2>
        @if (!string.Equals(user.Login, user.Nickname, StringComparison.Ordinal))
        {
            <p class="user-login">@user.Login</p>
        }

        <dl class="detail-summary">
            <div>
                <dt>Zone</dt>
                <dd>@(string.IsNullOrWhiteSpace(user.Zone) ? "Unknown" : user.Zone)</dd>
            </div>
            <div>
                <dt>Records</dt>
                <dd>@user.RecordCount</dd>
            </div>
        </dl>

        <h3>Recent records</h3>
        @if (user.RecentRecords.Length == 0)
        {
            <p>This player has no records.</p>
        }
        else
        {
            <div class="records-scroll">
                <table class="records-table">
                    <thead>
                        <tr>
                            <th scope="col">Map</th>
                            <th scope="col">Car</th>
                            <th scope="col">Laps</th>
                            <th scope="col">Time</th>
                            <th scope="col">Driven</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in user.RecentRecords)
                        {
                            <tr>
                                <td>
                                    <span class="primary-value">@GetMapName(record)</span>
                                    @if (!string.IsNullOrWhiteSpace(record.MapName))
                                    {
                                        <small>@record.MapUid</small>
                                    }
                                </td>
                                <td><a href="@GetCarUrl(record.Car)">@record.Car</a></td>
                                <td>@record.Laps</td>
                                <td><a href="@GetRecordUrl(record)">@FormatTime(record.Time)</a></td>
                                <td>@FormatDateTime(record.DrivenAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string UserLogin { get; set; } = "";

    private PlayerInfo? user;
    private bool isLoading = true;
    private bool loadFailed;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            user = await EnvimixService.GetUserAsync(UserLogin);
        }
        catch (Exception ex)
        {
            user = null;
            loadFailed = true;
            Logger.LogError(ex, "Unable to load player {UserLogin}", UserLogin);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetUserName(PlayerInfo value)
        => string.IsNullOrWhiteSpace(value.Nickname) ? value.Login : value.Nickname;

    private static string GetMapName(RecordInfo record)
        => string.IsNullOrWhiteSpace(record.MapName) ? record.MapUid : record.MapName;

    private static string GetCarUrl(string carId)
        => $"/cars/{Uri.EscapeDataString(carId)}";

    private static string GetRecordUrl(RecordInfo record)
        => $"/records/{Uri.EscapeDataString(record.MapUid)}/{Uri.EscapeDataString(record.Car)}/{Uri.EscapeDataString(record.UserLogin)}/{record.Time}";

    private static string FormatDateTime(DateTimeOffset dateTime)
        => dateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string FormatTime(int milliseconds)
        => TimeSpan.FromMilliseconds(milliseconds).ToString(milliseconds >= 3_600_000 ? @"h\:mm\:ss\.fff" : @"m\:ss\.fff");
}
