@page "/titles/{TitleId}"
@using TmEssentials
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<TitleDetails> Logger
@attribute [StreamRendering]

<PageTitle>@TextFormatter.Deformat(title?.DisplayName ?? title?.Id ?? TitleId) - ENVIMIX project</PageTitle>
<HeadContent>
    <MetadataTags Title="@(TextFormatter.Deformat(title?.DisplayName ?? title?.Id ?? TitleId) + " - ENVIMIX project")"
                  Description="@GetMetadataDescription()"></MetadataTags>
</HeadContent>

<ReuContainer>
    @if (isLoading)
    {
        <p>Loading title...</p>
    }
    else if (loadFailed)
    {
        <h2>@TitleId</h2>
        <p>Unable to load this title at this time.</p>
    }
    else if (title is null)
    {
        <h2>Title not found</h2>
        <p>This title does not exist or is not available.</p>
    }
    else
    {
        <h2>
            @if (string.IsNullOrWhiteSpace(title.DisplayName))
            {
                @title.Id
            }
            else
            {
                <FormattedText Text="@title.DisplayName"></FormattedText>
            }
        </h2>
        @if (!string.IsNullOrWhiteSpace(title.DisplayName))
        {
            <p class="title-id">@title.Id</p>
        }

        @if (title.Downloadable || string.Equals(title.Id, "Envimix_Turbo@bigbang1112", StringComparison.Ordinal))
        {
            <div class="title-actions">
                @if (title.Downloadable)
                {
                    <ReuButton Href="@GetDownloadUrl(title.Id)" download>Download</ReuButton>
                }
                @if (string.Equals(title.Id, "Envimix_Turbo@bigbang1112", StringComparison.Ordinal))
                {
                    <ReuButton Href="@GetPreviewDownloadUrl(title.Id)" download>Download preview</ReuButton>
                }
            </div>
        }

        <dl class="title-summary">
            <div><dt>Maps</dt><dd>@title.MapCount</dd></div>
            <div><dt>Records</dt><dd>@title.RecordCount</dd></div>
            <div><dt>Players</dt><dd>@title.PlayerCount</dd></div>
            <div><dt>Sessions</dt><dd>@title.SessionCount</dd></div>
            @if (!string.IsNullOrWhiteSpace(title.Version))
            {
                <div><dt>Version</dt><dd>@FormatVersion(title.Version)</dd></div>
            }
            <div><dt>Released</dt><dd>@FormatDateTime(title.ReleasedAt)</dd></div>
        </dl>

        <h3>Campaigns</h3>
        @if (title.Maps.Length == 0)
        {
            <p>No campaign maps belong to this title yet.</p>
        }
        else
        {
            @foreach (var campaign in title.Maps
                .GroupBy(map => map.Campaign ?? "")
                .OrderBy(campaign => string.IsNullOrWhiteSpace(campaign.Key) ? 0 : 1)
                .ThenBy(campaign => campaign.Key))
            {
                <section class="campaign">
                    @if (!string.IsNullOrWhiteSpace(campaign.Key))
                    {
                        <h4>
                            <FormattedText Text="@campaign.Key"></FormattedText>
                        </h4>
                    }
                    <div class="maps-scroll">
                        <table class="maps-table">
                            <thead>
                                <tr>
                                    <th scope="col">Map</th>
                                    <th scope="col">Environment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var map in campaign.OrderBy(map => map.Order is null).ThenBy(map => map.Order))
                                {
                                    <tr>
                                        <td>
                                            <a class="map-name" href="@GetMapUrl(map.Uid)"><FormattedText Text="@GetMapName(map)"></FormattedText></a>
                                            @if (!string.IsNullOrWhiteSpace(map.Name))
                                            {
                                                <small>@map.Uid</small>
                                            }
                                        </td>
                                        <td class="nowrap">@(string.IsNullOrWhiteSpace(map.Collection) ? "Unknown" : map.Collection)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string TitleId { get; set; } = "";

    private TitleDetailsInfo? title;
    private bool isLoading = true;
    private bool loadFailed;

    private string GetMetadataDescription()
        => title is null
            ? $"View campaigns for Trackmania title {TitleId} in ENVIMIX."
            : $"Browse campaigns for {TextFormatter.Deformat(title.DisplayName ?? title.Id)} in ENVIMIX.";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            title = await EnvimixService.GetTitleAsync(TitleId);
        }
        catch (Exception ex)
        {
            title = null;
            loadFailed = true;
            Logger.LogError(ex, "Unable to load title {TitleId}", TitleId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetMapName(TitleMapInfo map)
        => string.IsNullOrWhiteSpace(map.Name) ? map.Uid : map.Name;

    private static string GetMapUrl(string mapUid)
        => $"/maps/{Uri.EscapeDataString(mapUid)}";

    private static string GetDownloadUrl(string titleId)
        => $"/titles/{Uri.EscapeDataString(titleId)}/download";

    private static string GetPreviewDownloadUrl(string titleId)
        => $"/titles/{Uri.EscapeDataString(titleId)}/download/preview";

    private static string FormatVersion(string version)
    {
        var hashStart = version.IndexOf(" (", StringComparison.Ordinal);
        return hashStart < 0 ? version : version[..hashStart];
    }

    private static string FormatDateTime(DateTimeOffset? dateTime)
        => dateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Unknown";
}
