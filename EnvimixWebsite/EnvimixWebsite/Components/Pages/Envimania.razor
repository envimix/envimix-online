@page "/envimania"
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<Envimania> Logger
@attribute [StreamRendering]

<PageTitle>Envimania - ENVIMIX project</PageTitle>
<HeadContent>
    <MetadataTags Title="Envimania - ENVIMIX project"
                  Description="Browse Trackmania servers registered with Envimania."></MetadataTags>
</HeadContent>

<ReuContainer>
    <h1>Envimania</h1>
    <p><i>A Trackmania map was not ever meant to hold just one record per player...</i></p>
    <p><i>Every solution, every plugin, every project expects just a single record type - the default car one...</i></p>
    <p><i>No one tries to beat the tabu, as it would break those integral plugins and features...</i></p>
    <p><b>That's why Envimania was made</b> - combinations per map, historical improvements, solo and multiplayer connected.</p>
    <p>Envimania is the TM2's ENVIMIX leaderboard manager. Feels like leaderboards from the latest Trackmania, but also respects all of the cars. It is not perfect, but it works.</p>
    <h2>Registered servers</h2>

    @if (servers is null)
    {
        <p>Loading registered servers...</p>
    }
    else if (loadFailed)
    {
        <p>Unable to load registered servers at this time.</p>
    }
    else if (servers.Length == 0)
    {
        <p>No servers have been registered yet.</p>
    }
    else
    {
        <div class="server-table-scroll">
            <table class="server-table">
                <thead>
                    <tr>
                        <th scope="col">Server</th>
                        <th scope="col">Status</th>
                        <th scope="col">Sessions</th>
                        <th scope="col">Last seen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var server in servers)
                    {
                        <tr>
                            <td>
                                <a class="server-name" href="@GetServerUrl(server.ServerLogin)">
                                    @if (string.IsNullOrWhiteSpace(server.ServerName))
                                    {
                                        @server.ServerLogin
                                    }
                                    else
                                    {
                                        <FormattedText Text="@server.ServerName"></FormattedText>
                                    }
                                </a>
                                @if (!string.IsNullOrWhiteSpace(server.ServerName))
                                {
                                    <small class="server-login">@server.ServerLogin</small>
                                }
                            </td>
                            <td class="nowrap">@(server.IsHidden ? "Hidden" : server.IsBanned ? "Banned" : "Registered")</td>
                            <td class="nowrap">@server.SessionCount</td>
                            <td class="nowrap"><LocalDateTime Value="@server.LastSeenAt" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</ReuContainer>

@code {
    private EnvimaniaServerSummary[]? servers;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            servers = await EnvimixService.GetServersAsync();
        }
        catch (Exception ex)
        {
            loadFailed = true;
            servers = [];
            Logger.LogError(ex, "Unable to load registered servers");
        }
    }

    private static string GetServerUrl(string serverLogin)
        => $"/envimania/servers/{Uri.EscapeDataString(serverLogin)}";
}
