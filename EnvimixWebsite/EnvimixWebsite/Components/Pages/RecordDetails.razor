@page "/records/{MapUid}/{Car}/{UserLogin}/{Time:int}"
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<RecordDetails> Logger
@attribute [StreamRendering]

<PageTitle>@FormatTime(Time) - ENVIMIX record</PageTitle>

<ReuContainer>
    @if (isLoading)
    {
        <p>Loading record...</p>
    }
    else if (loadFailed)
    {
        <h2>@FormatTime(Time)</h2>
        <p>Unable to load this record at this time.</p>
    }
    else if (record is null)
    {
        <h2>Record not found</h2>
        <p>This record does not exist or is not available.</p>
    }
    else
    {
        @if (record.SessionId is Guid sessionId)
        {
            <p><a href="@GetSessionUrl(sessionId)">Session</a></p>
        }

        <h2>@FormatTime(record.Time)</h2>

        <dl class="record-summary">
            <div>
                <dt>Player</dt>
                <dd>
                    <a href="@GetUserUrl(record.UserLogin)">
                        @if (string.IsNullOrWhiteSpace(record.Nickname))
                        {
                            @record.UserLogin
                        }
                        else
                        {
                            <FormattedText Text="@record.Nickname"></FormattedText>
                        }
                    </a>
                </dd>
            </div>
            <div>
                <dt>Car</dt>
                <dd><CarDisplay CarId="@record.Car" IconSize="28" /></dd>
            </div>
            <div>
                <dt>Map</dt>
                <dd class="technical-value"><a href="@GetMapUrl(record.MapUid)"><FormattedText Text="@GetMapName(record)"></FormattedText></a></dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(record.TitleId))
            {
                <div>
                    <dt>Title</dt>
                    <dd>
                        <a href="@GetTitleUrl(record.TitleId)">
                            @if (string.IsNullOrWhiteSpace(record.TitleDisplayName))
                            {
                                @record.TitleId
                            }
                            else
                            {
                                <FormattedText Text="@record.TitleDisplayName"></FormattedText>
                            }
                        </a>
                    </dd>
                </div>
            }
            @if (ShouldShowLaps(record.MapLaps))
            {
                <div>
                    <dt>Laps</dt>
                    <dd>@FormatRecordLaps(record.MapLaps, record.Laps)</dd>
                </div>
            }
            <div>
                <dt>Gravity</dt>
                <dd>@record.Gravity</dd>
            </div>
            <div>
                <dt>Score</dt>
                <dd>@record.Score</dd>
            </div>
            <div>
                <dt>Respawns</dt>
                <dd>@record.NbRespawns</dd>
            </div>
            <div>
                <dt>Driven</dt>
                <dd>@FormatDateTime(record.DrivenAt)</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>@(record.Removed ? "Removed" : "Active")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(record.ServerLogin))
            {
                <div>
                    <dt>Server</dt>
                    <dd><a href="@GetServerUrl(record.ServerLogin)">@record.ServerLogin</a></dd>
                </div>
            }
        </dl>

        @if (canAdminister)
        {
            <form class="record-actions" method="post" action="@(record.Removed ? "/records/revert" : "/records/remove")" onsubmit="return confirm('@(record.Removed ? "Restore this record?" : "Remove this record?")');">
                <AntiforgeryToken />
                <input type="hidden" name="mapUid" value="@record.MapUid" />
                <input type="hidden" name="login" value="@record.UserLogin" />
                <input type="hidden" name="carId" value="@record.Car" />
                <input type="hidden" name="gravity" value="@record.Gravity" />
                <input type="hidden" name="laps" value="@record.Laps" />
                <input type="hidden" name="time" value="@record.Time" />
                <ReuButton type="submit">@(record.Removed ? "Restore" : "Remove")</ReuButton>
            </form>
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string MapUid { get; set; } = "";

    [Parameter]
    public string Car { get; set; } = "";

    [Parameter]
    public string UserLogin { get; set; } = "";

    [Parameter]
    public int Time { get; set; }

    private RecordInfo? record;
    private bool isLoading = true;
    private bool loadFailed;
    private bool canAdminister;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            canAdminister = authState.User.IsInRole(Roles.Admin);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            record = await EnvimixService.GetRecordAsync(MapUid, Car, UserLogin, Time);
        }
        catch (Exception ex)
        {
            record = null;
            loadFailed = true;
            Logger.LogError(ex,
                "Unable to load record {MapUid}/{Car}/{UserLogin}/{Time}",
                MapUid, Car, UserLogin, Time);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetMapName(RecordInfo value)
        => string.IsNullOrWhiteSpace(value.MapName) ? value.MapUid : value.MapName;

    private static string GetUserUrl(string userLogin)
        => $"/users/{Uri.EscapeDataString(userLogin)}";

    private static string GetMapUrl(string mapUid)
        => $"/maps/{Uri.EscapeDataString(mapUid)}";

    private static string GetTitleUrl(string titleId)
        => $"/titles/{Uri.EscapeDataString(titleId)}";

    private static string GetServerUrl(string serverLogin)
        => $"/envimania/servers/{Uri.EscapeDataString(serverLogin)}";

    private static string GetSessionUrl(Guid sessionId)
        => $"/envimania/sessions/{sessionId}";

    private static string FormatDateTime(DateTimeOffset dateTime)
        => dateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string FormatTime(int milliseconds)
        => TimeSpan.FromMilliseconds(milliseconds).ToString(milliseconds >= 3_600_000 ? @"h\:mm\:ss\.fff" : @"m\:ss\.fff");

    private static bool ShouldShowLaps(int mapLaps)
        => mapLaps == 0 || mapLaps > 1;

    private static string FormatRecordLaps(int mapLaps, int recordLaps)
        => mapLaps == 0 ? "Undefined" : recordLaps.ToString();

}
