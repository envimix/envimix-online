@page "/cars/{CarId}"
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<CarDetails> Logger
@attribute [StreamRendering]

<PageTitle>@CarId - ENVIMIX project</PageTitle>
<HeadContent>
    <MetadataTags Title="@(CarId + " - ENVIMIX project")"
                  Description="@GetMetadataDescription()"></MetadataTags>
</HeadContent>

<ReuContainer>
    @if (isLoading)
    {
        <p>Loading car...</p>
    }
    else if (loadFailed)
    {
        <h2><CarDisplay CarId="@CarId" Linked="false" IconSize="48" /></h2>
        <p>Unable to load this car at this time.</p>
    }
    else if (car is null)
    {
        <h2>Car not found</h2>
        <p>This car does not exist or is not available.</p>
    }
    else
    {
        <h2><CarDisplay CarId="@car.Id" Linked="false" IconSize="48" /></h2>

        <dl class="detail-summary">
            <div>
                <dt>Records</dt>
                <dd>@car.RecordCount</dd>
            </div>
            <div>
                <dt>Players</dt>
                <dd>@car.PlayerCount</dd>
            </div>
        </dl>

        <h3>Recent records</h3>
        @if (car.RecentRecords.Length == 0)
        {
            <p>No records have been driven with this car.</p>
        }
        else
        {
            var showLaps = car.RecentRecords.Any(record => ShouldShowLaps(record.MapLaps));
            <div class="records-scroll">
                <table class="records-table">
                    <thead>
                        <tr>
                            <th scope="col">Player</th>
                            <th scope="col">Map</th>
                            @if (showLaps)
                            {
                                <th scope="col">Laps</th>
                            }
                            <th scope="col">Time</th>
                            <th scope="col">Driven</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in car.RecentRecords)
                        {
                            <tr>
                                <td>
                                    <a class="primary-value" href="@GetUserUrl(record.UserLogin)">
                                        @if (string.IsNullOrWhiteSpace(record.Nickname))
                                        {
                                            @record.UserLogin
                                        }
                                        else
                                        {
                                            <FormattedText Text="@record.Nickname"></FormattedText>
                                        }
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(record.Nickname))
                                    {
                                        <small>@record.UserLogin</small>
                                    }
                                </td>
                                <td>
                                    <a class="primary-value" href="@GetMapUrl(record.MapUid)"><FormattedText Text="@GetMapName(record)"></FormattedText></a>
                                    @if (!string.IsNullOrWhiteSpace(record.MapName))
                                    {
                                        <small>@record.MapUid</small>
                                    }
                                </td>
                                @if (showLaps)
                                {
                                    <td>@FormatRecordLaps(record.MapLaps, record.Laps)</td>
                                }
                                <td>
                                    <a href="@GetRecordUrl(record)">@FormatTime(record.Time)</a>
                                    @if (record.Removed)
                                    {
                                        <span class="removed-note">(removed)</span>
                                    }
                                </td>
                                <td>@RelativeTimeFormatter.Format(record.DrivenAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string CarId { get; set; } = "";

    private CarInfo? car;
    private bool isLoading = true;
    private bool loadFailed;

    private string GetMetadataDescription()
        => car is null
            ? $"View records driven with {CarId} in ENVIMIX."
            : $"Browse {car.RecordCount} records driven by {car.PlayerCount} players with {car.Id} in ENVIMIX.";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            car = await EnvimixService.GetCarAsync(CarId);
        }
        catch (Exception ex)
        {
            car = null;
            loadFailed = true;
            Logger.LogError(ex, "Unable to load car {CarId}", CarId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetMapName(RecordInfo record)
        => string.IsNullOrWhiteSpace(record.MapName) ? record.MapUid : record.MapName;

    private static string GetUserUrl(string userLogin)
        => $"/users/{Uri.EscapeDataString(userLogin)}";

    private static string GetMapUrl(string mapUid)
        => $"/maps/{Uri.EscapeDataString(mapUid)}";

    private static string GetRecordUrl(RecordInfo record)
        => $"/records/{Uri.EscapeDataString(record.MapUid)}/{Uri.EscapeDataString(record.Car)}/{Uri.EscapeDataString(record.UserLogin)}/{record.Time}";

    private static string FormatTime(int milliseconds)
        => TimeSpan.FromMilliseconds(milliseconds).ToString(milliseconds >= 3_600_000 ? @"h\:mm\:ss\.fff" : @"m\:ss\.fff");

    private static bool ShouldShowLaps(int mapLaps)
        => mapLaps == 0 || mapLaps > 1;

    private static string FormatRecordLaps(int mapLaps, int recordLaps)
        => mapLaps == 0 ? "Undefined" : mapLaps > 1 ? recordLaps.ToString() : "";
}
