@page "/envimania/servers/{ServerLogin}"
@rendermode InteractiveServer
@using TmEssentials
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<ServerDetails> Logger
@inject IJSRuntime JS
@attribute [StreamRendering]

<PageTitle>@(server?.ServerLogin ?? ServerLogin) - ENVIMIX server</PageTitle>
<HeadContent>
    <MetadataTags Title="@(GetMetadataServerName() + " - ENVIMIX server")"
                  Description="@GetMetadataDescription()"></MetadataTags>
</HeadContent>

<ReuContainer>
    <p><a href="/envimania">Registered servers</a></p>

    @if (isLoading)
    {
        <p>Loading server information...</p>
    }
    else if (loadFailed)
    {
        <h2>@ServerLogin</h2>
        <p>Unable to load server information at this time.</p>
    }
    else if (server is null)
    {
        <h2>Server not found</h2>
        <p><strong>@ServerLogin</strong> is not registered with Envimania.</p>
    }
    else
    {
        <h2>
            @if (string.IsNullOrWhiteSpace(server.ServerName))
            {
                @server.ServerLogin
            }
            else
            {
                <FormattedText Text="@server.ServerName"></FormattedText>
            }
        </h2>
        @if (!string.IsNullOrWhiteSpace(server.ServerName))
        {
            <p class="server-login">@server.ServerLogin</p>
        }

        <dl class="server-summary">
            <div>
                <dt>Status</dt>
                <dd>@(server.IsHidden ? "Hidden" : server.IsBanned ? "Banned" : "Registered")</dd>
            </div>
            <div>
                <dt>Sessions</dt>
                <dd>@server.SessionCount</dd>
            </div>
            <div>
                <dt>Registered at</dt>
                <dd>@FormatDateTime(server.RegisteredAt)</dd>
            </div>
            <div>
                <dt>Last seen</dt>
                <dd>@FormatDateTime(server.LastSeenAt)</dd>
            </div>
        </dl>

        <div class="sessions-heading">
            <h3>Recent sessions</h3>
            <label>
                <input type="checkbox" @bind="WithPlayersOnly" @bind:after="FilterSessionsAsync" disabled="@sessionsLoading" />
                With players only
            </label>
        </div>
        @if (server.RecentSessions.Length == 0)
        {
            <p>@(WithPlayersOnly ? "No sessions with players found." : "This server has not started an Envimania session yet.")</p>
        }
        else
        {
            <div class="session-table-scroll">
            <table class="session-table">
                <thead>
                    <tr>
                        <th scope="col">Map</th>
                        <th scope="col">Mode</th>
                        <th scope="col">Title</th>
                        <th scope="col">Players</th>
                        <th scope="col">Started</th>
                        <th scope="col">Ended</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in server.RecentSessions)
                    {
                        <tr>
                            <td>
                                <a class="map-name" href="@GetMapUrl(session.MapUid)">@(string.IsNullOrWhiteSpace(session.MapName) ? session.MapUid : session.MapName)</a>
                                @if (!string.IsNullOrWhiteSpace(session.MapName))
                                {
                                    <small class="map-uid nowrap">@session.MapUid</small>
                                }
                            </td>
                            <td class="nowrap">@(string.IsNullOrWhiteSpace(session.ServerModeName) ? "-" : session.ServerModeName)</td>
                            <td class="nowrap">
                                @if (string.IsNullOrWhiteSpace(session.TitleId))
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <a href="@GetTitleUrl(session.TitleId)">
                                        @if (string.IsNullOrWhiteSpace(session.TitleDisplayName))
                                        {
                                            @session.TitleId
                                        }
                                        else
                                        {
                                            <FormattedText Text="@session.TitleDisplayName"></FormattedText>
                                        }
                                    </a>
                                }
                            </td>
                            <td class="nowrap">@session.PlayerCount</td>
                            <td class="nowrap"><a href="@GetSessionUrl(session.Id)">@FormatDateTime(session.StartedAt)</a></td>
                            <td class="nowrap">
                                @FormatDateTime(session.EndedAt, "Not closed")
                                @if (IsExpired(session.EndedAt, session.FinishedGracefully))
                                {
                                    <small class="expired-note">(expired)</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <nav class="sessions-pagination" aria-label="Session pages">
                <ReuButton Disabled="@(sessionsLoading || server.Page <= 1)" OnClick="() => GoToPageAsync(server.Page - 1)">Previous</ReuButton>
                @foreach (var pageNumber in GetVisiblePages())
                {
                    @if (pageNumber == 0)
                    {
                        <span aria-hidden="true">...</span>
                    }
                    else
                    {
                        <ReuButton Active="@(pageNumber == server.Page)"
                                   aria-current="@(pageNumber == server.Page ? "page" : null)"
                                   Disabled="@(sessionsLoading || pageNumber == server.Page)"
                                   OnClick="() => GoToPageAsync(pageNumber)">@pageNumber</ReuButton>
                    }
                }
                <ReuButton Disabled="@(sessionsLoading || server.Page >= TotalPages)" OnClick="() => GoToPageAsync(server.Page + 1)">Next</ReuButton>
                <small>@server.MatchingSessionCount sessions</small>
            </nav>
        }

        @if (server.CanDelete)
        {
            <section class="server-actions">
                <h2>Server actions</h2>
                <div class="action-buttons">
                    @if (server.IsHidden && server.CanAdminister)
                    {
                        <form method="post" action="/envimania/servers/register">
                            <AntiforgeryToken />
                            <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                            <input type="hidden" name="returnToServer" value="true" />
                            <ReuButton type="submit">Register</ReuButton>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="/envimania/servers/delete" onsubmit="return confirm('Unregister this server from Envimania? Its data will be preserved and admins will continue seeing it.');">
                            <AntiforgeryToken />
                            <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                            <ReuButton type="submit">Unregister</ReuButton>
                        </form>
                    }

                    @if (server.CanAdminister)
                    {
                        @if (!server.IsBanned)
                        {
                            <form method="post" action="/envimania/servers/ban" onsubmit="const reason = prompt('Enter the ban reason:'); if (reason === null || !reason.trim()) return false; this.elements.reason.value = reason.trim(); return true;">
                                <AntiforgeryToken />
                                <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                                <input type="hidden" name="reason" />
                                <ReuButton type="submit">Ban</ReuButton>
                            </form>
                        }
                        else
                        {
                            <form method="post" action="/envimania/servers/unban" onsubmit="return confirm('Unban this server?');">
                                <AntiforgeryToken />
                                <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                                <ReuButton type="submit">Unban</ReuButton>
                            </form>
                        }
                    }
                </div>
            </section>

            <section class="danger-zone">
                <h2>Danger zone</h2>
                <div class="danger-actions">
                    @if (server.CanAdminister)
                    {
                        <form method="post" action="/envimania/servers/delete-records" onsubmit="return confirm('Permanently delete every record driven on this server?');">
                            <AntiforgeryToken />
                            <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                            <ReuButton type="submit" Variant="ReuButtonVariant.Red">Delete records</ReuButton>
                        </form>

                        <form method="post" action="/envimania/servers/delete-ratings" onsubmit="return confirm('Permanently delete every rating submitted by this server?');">
                            <AntiforgeryToken />
                            <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                            <ReuButton type="submit" Variant="ReuButtonVariant.Red">Delete ratings</ReuButton>
                        </form>

                        <form method="post" action="/envimania/servers/wipe" onsubmit="return confirm('Permanently wipe this server, including its registration, sessions, records, and ratings? This cannot be undone.');">
                            <AntiforgeryToken />
                            <input type="hidden" name="serverLogin" value="@server.ServerLogin" />
                            <ReuButton type="submit" Variant="ReuButtonVariant.Red">Full wipe</ReuButton>
                        </form>
                    }
                </div>
            </section>
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string ServerLogin { get; set; } = "";

    [SupplyParameterFromQuery(Name = "page")]
    public int SessionPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "withPlayers")]
    public bool WithPlayersOnly { get; set; }

    private EnvimaniaServerInfo? server;
    private bool isLoading = true;
    private bool sessionsLoading;
    private bool loadFailed;
    private bool appliedWithPlayersOnly;

    private int TotalPages => server is null
        ? 1
        : Math.Max(1, (int)Math.Ceiling(server.MatchingSessionCount / (double)server.PageSize));

    private string GetMetadataServerName()
        => TextFormatter.Deformat(server is null || string.IsNullOrWhiteSpace(server.ServerName)
            ? ServerLogin
            : server.ServerName);

    private string GetMetadataDescription()
        => server is null
            ? $"View Envimania sessions hosted by in server {ServerLogin}."
            : $"Browse {server.SessionCount} Envimania sessions in {GetMetadataServerName()}.";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        try
        {
            server = await EnvimixService.GetServerAsync(ServerLogin, SessionPage, withPlayersOnly: WithPlayersOnly);
            SessionPage = server?.Page ?? 1;
            appliedWithPlayersOnly = WithPlayersOnly;
        }
        catch (Exception ex)
        {
            server = null;
            loadFailed = true;
            Logger.LogError(ex, "Unable to load server {ServerLogin}", ServerLogin);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatDateTime(DateTimeOffset? dateTime, string emptyText = "Never")
        => dateTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? emptyText;

    private static string GetSessionUrl(Guid sessionId)
        => $"/envimania/sessions/{sessionId}";

    private static string GetMapUrl(string mapUid)
        => $"/maps/{Uri.EscapeDataString(mapUid)}";

    private static string GetTitleUrl(string titleId)
        => $"/titles/{Uri.EscapeDataString(titleId)}";

    private Task GoToPageAsync(int page)
        => LoadSessionsPageAsync(page, WithPlayersOnly);

    private async Task LoadSessionsPageAsync(int page, bool withPlayersOnly)
    {
        if (server is null || sessionsLoading)
        {
            return;
        }

        sessionsLoading = true;

        try
        {
            var updatedServer = await EnvimixService.GetServerAsync(ServerLogin, page, withPlayersOnly: withPlayersOnly);
            if (updatedServer is null)
            {
                return;
            }

            SessionPage = updatedServer.Page;
            appliedWithPlayersOnly = withPlayersOnly;
            server = server with
            {
                SessionCount = updatedServer.SessionCount,
                MatchingSessionCount = updatedServer.MatchingSessionCount,
                Page = updatedServer.Page,
                PageSize = updatedServer.PageSize,
                RecentSessions = updatedServer.RecentSessions
            };

            await UpdateUrlAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load more sessions for server {ServerLogin}", ServerLogin);
        }
        finally
        {
            sessionsLoading = false;
        }
    }

    private async Task FilterSessionsAsync()
    {
        if (server is null || sessionsLoading)
        {
            return;
        }

        try
        {
            await LoadSessionsPageAsync(1, WithPlayersOnly);
        }
        catch (Exception ex)
        {
            WithPlayersOnly = appliedWithPlayersOnly;
            Logger.LogError(ex, "Unable to filter sessions for server {ServerLogin}", ServerLogin);
        }
    }

    private ValueTask UpdateUrlAsync()
    {
        var filterQuery = WithPlayersOnly ? "&withPlayers=true" : "";
        var url = $"/envimania/servers/{Uri.EscapeDataString(ServerLogin)}?page={SessionPage}{filterQuery}";
        return JS.InvokeVoidAsync("history.replaceState", null, "", url);
    }

    private IEnumerable<int> GetVisiblePages()
    {
        var currentPage = server?.Page ?? 1;
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(TotalPages, currentPage + 2);

        if (start > 1)
        {
            yield return 1;
            if (start > 2)
            {
                yield return 0;
            }
        }

        for (var page = start; page <= end; page++)
        {
            yield return page;
        }

        if (end < TotalPages)
        {
            if (end < TotalPages - 1)
            {
                yield return 0;
            }
            yield return TotalPages;
        }
    }

    private static bool IsExpired(DateTimeOffset? endedAt, bool finishedGracefully)
        => endedAt is not null && !finishedGracefully;
}
