@page "/maps/{MapUid}"
@rendermode InteractiveServer
@using TmEssentials
@using TmEssentials.Razor
@inject IEnvimixService EnvimixService
@inject ILogger<MapDetails> Logger
@inject IJSRuntime JS
@attribute [StreamRendering]

<PageTitle>@TextFormatter.Deformat(map is null ? MapUid : GetMapName(map)) - ENVIMIX map</PageTitle>
<HeadContent>
    <MetadataTags Title="@(TextFormatter.Deformat(map is null ? MapUid : GetMapName(map)) + " - ENVIMIX map")"
                  Description="@GetMetadataDescription()"></MetadataTags>
</HeadContent>

<ReuContainer>
    @if (isLoading)
    {
        <p>Loading map...</p>
    }
    else if (loadFailed)
    {
        <h2>@MapUid</h2>
        <p>Unable to load this map at this time.</p>
    }
    else if (map is null)
    {
        <h2>Map not found</h2>
        <p>This map does not exist or is not available.</p>
    }
    else
    {
        <h2><FormattedText Text="@GetMapName(map)"></FormattedText></h2>
        <p class="map-uid">@map.Uid</p>

        <dl class="map-summary">
            @if (!string.IsNullOrWhiteSpace(map.AuthorLogin))
            {
                <div>
                    <dt>Author</dt>
                    <dd><a href="@GetUserUrl(map.AuthorLogin)"><FormattedText Text="@GetAuthorName(map)"></FormattedText></a></dd>
                </div>
            }
            <div>
                <dt>Environment</dt>
                <dd>@(string.IsNullOrWhiteSpace(map.Collection) ? "Unknown" : map.Collection)</dd>
            </div>
            @if (map.TitlePack is not null)
            {
                <div>
                    <dt>Title</dt>
                    <dd>
                        <a href="@GetTitleUrl(map.TitlePack.Id)">
                            @if (string.IsNullOrWhiteSpace(map.TitlePack.DisplayName))
                            {
                                @map.TitlePack.Id
                            }
                            else
                            {
                                <FormattedText Text="@map.TitlePack.DisplayName"></FormattedText>
                            }
                        </a>
                    </dd>
                </div>
            }
            @if (ShouldShowLaps(map.Laps))
            {
                <div>
                    <dt>Laps</dt>
                    <dd>@FormatMapLaps(map.Laps)</dd>
                </div>
            }
        </dl>

        @if (map.AuthorTime > 0 || map.GoldTime > 0 || map.SilverTime > 0 || map.BronzeTime > 0)
        {
            <h3 class="medals-heading">Medals</h3>
            <dl class="medal-list">
                @if (map.AuthorTime > 0)
                {
                    <div class="medal-time author-medal">
                        <dt>Author</dt>
                        <dd>@FormatTime(map.AuthorTime)</dd>
                    </div>
                }
                @if (map.GoldTime > 0)
                {
                    <div class="medal-time gold-medal">
                        <dt>Gold</dt>
                        <dd>@FormatTime(map.GoldTime)</dd>
                    </div>
                }
                @if (map.SilverTime > 0)
                {
                    <div class="medal-time silver-medal">
                        <dt>Silver</dt>
                        <dd>@FormatTime(map.SilverTime)</dd>
                    </div>
                }
                @if (map.BronzeTime > 0)
                {
                    <div class="medal-time bronze-medal">
                        <dt>Bronze</dt>
                        <dd>@FormatTime(map.BronzeTime)</dd>
                    </div>
                }
            </dl>
        }

        <div class="records-heading">
            <h3>Records</h3>
            @if (recordsPage is not null)
            {
                <div class="record-options" role="radiogroup" aria-label="Record display mode">
                    <ReuButton Active="@(CurrentRecordMode == RecordMode.Best)"
                               Disabled="@(recordsLoading || CurrentRecordMode == RecordMode.Best)"
                               role="radio"
                               aria-checked="@(CurrentRecordMode == RecordMode.Best)"
                               OnClick="() => ChangeRecordModeAsync(RecordMode.Best)">Best records</ReuButton>
                    <ReuButton Active="@(CurrentRecordMode == RecordMode.All)"
                               Disabled="@(recordsLoading || CurrentRecordMode == RecordMode.All)"
                               role="radio"
                               aria-checked="@(CurrentRecordMode == RecordMode.All)"
                               OnClick="() => ChangeRecordModeAsync(RecordMode.All)">All records</ReuButton>
                    <ReuButton Active="@(CurrentRecordMode == RecordMode.WorldRecordHistory)"
                               Disabled="@(recordsLoading || CurrentRecordMode == RecordMode.WorldRecordHistory)"
                               role="radio"
                               aria-checked="@(CurrentRecordMode == RecordMode.WorldRecordHistory)"
                               OnClick="() => ChangeRecordModeAsync(RecordMode.WorldRecordHistory)">WR history</ReuButton>
                </div>
            }
        </div>
        @if (recordsPage is null)
        {
            @if (recordsLoadFailed)
            {
                <p>Unable to load records at this time.</p>
            }
            else
            {
                <p>Loading records...</p>
            }
        }
        else if (recordsPage.Cars.Length == 0)
        {
            <p>@(WorldRecordHistory ? "No world record history is available for this map yet." : "No records have been driven on this map yet.")</p>
        }
        else
        {
            <div class="car-tabs" role="tablist" aria-label="Cars">
                @foreach (var car in recordsPage.Cars)
                {
                    <ReuButton CssClass="car-tab"
                               role="tab"
                               Active="@(car.Id == recordsPage.Car)"
                               aria-selected="@(car.Id == recordsPage.Car)"
                               Disabled="@recordsLoading"
                               OnClick="() => SelectCarAsync(car.Id)">
                        <CarDisplay CarId="@car.Id" Linked="false" />
                        <span class="record-count" title="@car.RecordCount records">@car.RecordCount</span>
                    </ReuButton>
                }
            </div>

            <section class="map-records" aria-busy="@recordsLoading">
                <h4><CarDisplay CarId="@(recordsPage.Car ?? "")" Linked="false" IconSize="42" /></h4>
                @if (SelectedCar is { } selectedCar)
                {
                    <p class="selected-car-validator">
                        @if (selectedCar.ValidatorLogin is null)
                        {
                            <span>Unvalidated</span>
                        }
                        else
                        {
                            <span>Validated by </span><a href="@GetUserUrl(selectedCar.ValidatorLogin)"><FormattedText Text="@GetValidatorName(selectedCar)"></FormattedText></a>
                        }
                    </p>
                }

                @if (recordsLoadFailed)
                {
                    <p>Unable to load this records page.</p>
                }
                else
                {
                    <div class="records-scroll">
                        <table class="records-table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Player</th>
                                    @if (ShouldShowLaps(map.Laps))
                                    {
                                        <th scope="col">Laps</th>
                                    }
                                    <th scope="col">Time</th>
                                    <th scope="col">Driven</th>
                                    <th scope="col">Server</th>
                                    <th scope="col"><span class="visually-hidden">Download</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var index = 0; index < recordsPage.Records.Length; index++)
                                {
                                    var record = recordsPage.Records[index];
                                    <tr class="@(record.Removed ? "removed-record" : null)">
                                        <td>@(record.Rank > 0 ? record.Rank : null)</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(record.Nickname))
                                            {
                                                <a class="player-name" href="@GetUserUrl(record.UserLogin)">@record.UserLogin</a>
                                            }
                                            else
                                            {
                                                <a class="player-name" href="@GetUserUrl(record.UserLogin)"><FormattedText Text="@record.Nickname"></FormattedText></a>
                                                <small>@record.UserLogin</small>
                                            }
                                        </td>
                                        @if (ShouldShowLaps(map.Laps))
                                        {
                                            <td>@FormatRecordLaps(map.Laps, record.Laps)</td>
                                        }
                                        <td>
                                            <a href="@GetRecordUrl(record)">@FormatTime(record.Time)</a>
                                            @if (record.Removed)
                                            {
                                                <small>(removed)</small>
                                            }
                                        </td>
                                        <td>@FormatDateTime(record.DrivenAt)</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(record.ServerLogin))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                <a href="@GetServerUrl(record.ServerLogin)">@record.ServerLogin</a>
                                            }
                                        </td>
                                        <td>
                                            @if (record.GhostId is Guid ghostId)
                                            {
                                                <ReuButton Href="@EnvimixService.GetGhostDownloadUrl(ghostId)" CssClass="ghost-download" download>Download</ReuButton>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav class="records-pagination" aria-label="Records pages">
                        <ReuButton Disabled="@(recordsLoading || recordsPage.Page <= 1)" OnClick="() => GoToPageAsync(recordsPage.Page - 1)">Previous</ReuButton>
                        @foreach (var pageNumber in GetVisiblePages())
                        {
                            @if (pageNumber == 0)
                            {
                                <span aria-hidden="true">...</span>
                            }
                            else
                            {
                                <ReuButton Active="@(pageNumber == recordsPage.Page)"
                                       aria-current="@(pageNumber == recordsPage.Page ? "page" : null)"
                                       Disabled="@(recordsLoading || pageNumber == recordsPage.Page)"
                                       OnClick="() => GoToPageAsync(pageNumber)">@pageNumber</ReuButton>
                            }
                        }
                            <ReuButton Disabled="@(recordsLoading || recordsPage.Page >= TotalPages)" OnClick="() => GoToPageAsync(recordsPage.Page + 1)">Next</ReuButton>
                        <small>@recordsPage.TotalCount records</small>
                    </nav>
                }
            </section>
        }
    }
</ReuContainer>

@code {
    [Parameter]
    public string MapUid { get; set; } = "";

    [SupplyParameterFromQuery(Name = "car")]
    public string? RecordCar { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int RecordPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "all")]
    public bool ShowAllRecords { get; set; }

    [SupplyParameterFromQuery(Name = "history")]
    public bool WorldRecordHistory { get; set; }

    private MapDetailsInfo? map;
    private MapRecordsPage? recordsPage;
    private bool isLoading = true;
    private bool recordsLoading;
    private bool loadFailed;
    private bool recordsLoadFailed;
    private bool appliedShowAllRecords;
    private bool appliedWorldRecordHistory;

    private RecordMode CurrentRecordMode => WorldRecordHistory
        ? RecordMode.WorldRecordHistory
        : ShowAllRecords ? RecordMode.All : RecordMode.Best;

    private int TotalPages => recordsPage is null
        ? 1
        : Math.Max(1, (int)Math.Ceiling(recordsPage.TotalCount / (double)recordsPage.PageSize));

    private MapRecordCarInfo? SelectedCar
        => recordsPage?.Cars.FirstOrDefault(car => car.Id == recordsPage.Car);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadFailed = false;

        await Task.WhenAll(
            LoadMapAsync(),
            LoadRecordsAsync(RecordCar, RecordPage, updateUrl: false));

        isLoading = false;
    }

    private async Task LoadMapAsync()
    {
        try
        {
            map = await EnvimixService.GetMapAsync(MapUid);
        }
        catch (Exception ex)
        {
            map = null;
            loadFailed = true;
            Logger.LogError(ex, "Unable to load map {MapUid}", MapUid);
        }
    }

    private static string GetMapName(MapDetailsInfo value)
        => string.IsNullOrWhiteSpace(value.Name) ? value.Uid : value.Name;

    private static string GetAuthorName(MapDetailsInfo value)
        => string.IsNullOrWhiteSpace(value.AuthorNickname) ? value.AuthorLogin! : value.AuthorNickname;

    private string GetMetadataDescription()
    {
        if (map is null)
        {
            return $"View map details and records for map {MapUid} in ENVIMIX.";
        }

        var mapName = TextFormatter.Deformat(GetMapName(map));
        var environment = string.IsNullOrWhiteSpace(map.Collection) ? "an unknown environment" : map.Collection;

        return string.IsNullOrWhiteSpace(map.AuthorLogin)
            ? $"View map details and records for {mapName} ({environment})."
            : $"View map details and records for {mapName} ({environment}) by {TextFormatter.Deformat(GetAuthorName(map))}.";
    }

    private static string GetValidatorName(MapRecordCarInfo car)
        => string.IsNullOrWhiteSpace(car.ValidatorNickname) ? car.ValidatorLogin! : car.ValidatorNickname;

    private static bool ShouldShowLaps(int mapLaps)
        => mapLaps == 0 || mapLaps > 1;

    private static string FormatMapLaps(int mapLaps)
        => mapLaps == 0 ? "Undefined" : mapLaps.ToString();

    private async Task SelectCarAsync(string car)
    {
        if (recordsPage?.Car == car)
        {
            return;
        }

        await LoadRecordsAsync(car, 1, updateUrl: true);
    }

    private Task GoToPageAsync(int page)
        => LoadRecordsAsync(recordsPage?.Car, page, updateUrl: true);

    private async Task ChangeRecordModeAsync(RecordMode mode)
    {
        if (mode == CurrentRecordMode)
        {
            return;
        }

        ShowAllRecords = mode == RecordMode.All;
        WorldRecordHistory = mode == RecordMode.WorldRecordHistory;

        await LoadRecordsAsync(recordsPage?.Car, 1, updateUrl: true);
        if (recordsLoadFailed)
        {
            ShowAllRecords = appliedShowAllRecords;
            WorldRecordHistory = appliedWorldRecordHistory;
        }
    }

    private async Task LoadRecordsAsync(string? car, int page, bool updateUrl)
    {
        if (recordsLoading)
        {
            return;
        }

        recordsLoading = true;
        recordsLoadFailed = false;

        try
        {
            var result = await EnvimixService.GetMapRecordsAsync(
                MapUid,
                car,
                page,
                showAll: ShowAllRecords,
                worldRecordHistory: WorldRecordHistory);
            if (result is null)
            {
                recordsLoadFailed = true;
                return;
            }

            recordsPage = result;
            RecordCar = result.Car;
            RecordPage = result.Page;
            ShowAllRecords = result.ShowAll;
            WorldRecordHistory = result.WorldRecordHistory;
            appliedShowAllRecords = result.ShowAll;
            appliedWorldRecordHistory = result.WorldRecordHistory;

            if (updateUrl)
            {
                var carQuery = string.IsNullOrWhiteSpace(result.Car)
                    ? ""
                    : $"&car={Uri.EscapeDataString(result.Car)}";
                var allQuery = result.ShowAll ? "&all=true" : "";
                var historyQuery = result.WorldRecordHistory ? "&history=true" : "";
                var url = $"/maps/{Uri.EscapeDataString(MapUid)}?page={result.Page}{carQuery}{allQuery}{historyQuery}";
                await JS.InvokeVoidAsync("history.replaceState", null, "", url);
            }
        }
        catch (Exception ex)
        {
            recordsLoadFailed = true;
            Logger.LogError(ex, "Unable to load records for map {MapUid}", MapUid);
        }
        finally
        {
            recordsLoading = false;
        }
    }

    private IEnumerable<int> GetVisiblePages()
    {
        var currentPage = recordsPage?.Page ?? 1;
        var start = Math.Max(1, currentPage - 2);
        var end = Math.Min(TotalPages, currentPage + 2);

        if (start > 1)
        {
            yield return 1;
            if (start > 2)
            {
                yield return 0;
            }
        }

        for (var page = start; page <= end; page++)
        {
            yield return page;
        }

        if (end < TotalPages)
        {
            if (end < TotalPages - 1)
            {
                yield return 0;
            }
            yield return TotalPages;
        }
    }

    private static string GetUserUrl(string userLogin)
        => $"/users/{Uri.EscapeDataString(userLogin)}";

    private static string GetTitleUrl(string titleId)
        => $"/titles/{Uri.EscapeDataString(titleId)}";

    private static string GetRecordUrl(RecordInfo record)
        => $"/records/{Uri.EscapeDataString(record.MapUid)}/{Uri.EscapeDataString(record.Car)}/{Uri.EscapeDataString(record.UserLogin)}/{record.Time}";

    private static string GetServerUrl(string serverLogin)
        => $"/envimania/servers/{Uri.EscapeDataString(serverLogin)}";

    private static string FormatRecordLaps(int mapLaps, int recordLaps)
        => mapLaps == 0 ? "Undefined" : recordLaps.ToString();

    private static string FormatDateTime(DateTimeOffset dateTime)
        => dateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string FormatTime(int milliseconds)
        => TimeSpan.FromMilliseconds(milliseconds).ToString(milliseconds >= 3_600_000 ? @"h\:mm\:ss\.fff" : @"m\:ss\.fff");

    private enum RecordMode
    {
        Best,
        All,
        WorldRecordHistory
    }
}
