    <section aria-labelledby="tmuf-heading">
        <h2 id="tmuf-heading">Trackmania United Forever</h2>
        <div class="server-list">
            <a class="server-link" href="tmtp://#join=NadeoEnviMix">NADEO ENVIMIX</a>
            <a class="server-link" href="tmtp://#join=NadeoEnviMixStunts">NADEO ENVIMIX (Stunts)</a>
